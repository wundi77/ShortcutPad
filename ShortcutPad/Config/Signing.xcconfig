// Team-ID: kann leer bleiben. Mit einer kostenlosen Apple-ID wählst du in Xcode das
// „Personal Team“ aus; ein erneuter Lauf von ./setup.sh trägt die ID dann hier selbst ein.
// Du kannst sie auch von Hand eintragen (10 Zeichen).
DEVELOPMENT_TEAM =

// Muss weltweit eindeutig sein. Daraus werden "<Präfix>.ios" und "<Präfix>.helper".
PAD_BUNDLE_PREFIX = com.wundi77.shortcutpad
